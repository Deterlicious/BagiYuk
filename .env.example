# Server OCR is disabled safely until every protected binding/secret is present.
# Use "mock" only in local development. Production accepts "cloudrun" after provisioning.
RECEIPT_AI_PROVIDER=disabled

# Public Turnstile configuration. The secret key must be set with `wrangler secret put`.
TURNSTILE_SITE_KEY=
TURNSTILE_EXPECTED_HOSTNAME=localhost

# Private Cloud Run service. Store the WIF signing key and quota salt as Wrangler secrets.
CLOUD_RUN_OCR_URL=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_WIF_AUDIENCE=
GOOGLE_WIF_ISSUER=
GOOGLE_WIF_SUBJECT=
GOOGLE_WIF_KEY_ID=
GOOGLE_WIF_PRIVATE_KEY=
OCR_QUOTA_SECRET=
TURNSTILE_SECRET_KEY=

# Optional model overrides. Keep these values server-side.
RECEIPT_AI_MODEL=@cf/google/gemma-4-26b-a4b-it
RECEIPT_AI_FALLBACK_MODEL=@cf/moondream/moondream3.1-9B-A2B
