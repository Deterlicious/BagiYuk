# Optional legacy server-provider boundary. Production OCR runs locally and needs no env values.
# Use "mock" by default; "cloudflare" additionally requires a server-side AI binding.
RECEIPT_AI_PROVIDER=mock

# Optional model overrides. Keep these values server-side.
RECEIPT_AI_MODEL=@cf/google/gemma-4-26b-a4b-it
RECEIPT_AI_FALLBACK_MODEL=@cf/moondream/moondream3.1-9B-A2B
