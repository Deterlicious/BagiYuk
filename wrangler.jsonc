{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bagiyuk",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "RECEIPT_AI_PROVIDER": "mock"
  },
  "env": {
    "production": {
      "name": "bagiyuk",
      "vars": {
        "RECEIPT_AI_PROVIDER": "mock"
      }
    }
  },
  "observability": {
    "enabled": true
  }
}
