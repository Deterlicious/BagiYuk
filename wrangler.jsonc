{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bagiyuk",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "OCR_QUOTA",
      "database_name": "bagiyuk-ocr-quota",
      "database_id": "c08d9cac-8faf-47c3-a3e9-50f0713f712e",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "RECEIPT_AI_PROVIDER": "disabled"
  },
  "env": {
    "production": {
      "name": "bagiyuk",
      "d1_databases": [
        {
          "binding": "OCR_QUOTA",
          "database_name": "bagiyuk-ocr-quota",
          "database_id": "c08d9cac-8faf-47c3-a3e9-50f0713f712e",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "RECEIPT_AI_PROVIDER": "cloudrun",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAEMWbJRe26o7qMOx",
        "TURNSTILE_EXPECTED_HOSTNAME": "bagiyuk.vivoy51577.workers.dev",
        "CLOUD_RUN_OCR_URL": "https://bagiyuk-receipt-ocr-vf76ow3g7a-as.a.run.app",
        "GOOGLE_SERVICE_ACCOUNT_EMAIL": "bagiyuk-worker-invoker@project-592af0e7-ebee-4483-88e.iam.gserviceaccount.com",
        "GOOGLE_WIF_AUDIENCE": "//iam.googleapis.com/projects/513268340263/locations/global/workloadIdentityPools/bagiyuk-cloudflare/providers/bagiyuk-worker",
        "GOOGLE_WIF_ISSUER": "https://bagiyuk.vivoy51577.workers.dev/wif",
        "GOOGLE_WIF_SUBJECT": "bagiyuk-receipt-ocr-prod",
        "GOOGLE_WIF_KEY_ID": "bagiyuk-msnoned9-dd58e93c"
      }
    }
  },
  "observability": {
    "enabled": true
  }
}
