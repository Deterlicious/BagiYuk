{
  "name": "bagiyuk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:ocr-service": "python -m unittest discover -s services/receipt-ocr/tests -t services/receipt-ocr -p test_*.py",
    "benchmark:cord": "vitest run --config vitest.cord.config.ts",
    "benchmark:cord:fetch": "node scripts/fetch-cord-benchmark.mjs",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run-e2e.mjs",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "assets:pwa": "node scripts/generate-pwa-icons.mjs",
    "build": "next build",
    "cf:build": "opennextjs-cloudflare build && node scripts/prune-unused-ort-assets.mjs",
    "preview": "pnpm cf:build && opennextjs-cloudflare preview",
    "deploy": "pnpm cf:build && opennextjs-cloudflare deploy --env production",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@paddleocr/paddleocr-js": "0.4.2",
    "lucide-react": "1.46.0",
    "motion": "13.3.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.1.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "postcss": "8.5.26",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "wrangler": "4.119.0"
  }
}
